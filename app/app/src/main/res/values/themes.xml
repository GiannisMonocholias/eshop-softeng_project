<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Team21" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Backgrounds & Surfaces -->
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="colorSurface">@color/card_light</item>
        <item name="colorSurfaceVariant">@color/input_bg_light</item>

        <!-- Typography -->
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_muted_light</item>

        <item name="colorOnPrimary">@color/white</item>

        <!-- Brand Colors -->
        <item name="colorPrimary">@color/eshop_primary</item>
        <item name="colorSecondary">@color/eshop_accent</item>

        <item name="colorError">@color/error_red_light</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Custom Attributes -->
        <item name="colorFilterActive">@color/filter_active_light</item>
        <item name="colorFilterUnselected">@color/filter_bg_unselected_light</item>

        <!-- Menu buttons colour -->
        <item name="colorMenuButton">@color/teal_menu_light</item>
    </style>


    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Theme.Team21" parent="Base.Theme.Team21" />
</resources>