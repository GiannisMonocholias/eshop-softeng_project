<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtItemOrderPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtItemOrderSubmissionDate"
        android:text="Τιμή:" />

    <TextView
        android:id="@+id/txtItemOrderSubmissionDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtItemOrderCustomerName"
        android:text="Ημερομηνία υποβολής:" />

    <TextView
        android:id="@+id/txtItemOrderId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Κωδικός παραγγελίας:" />

    <TextView
        android:id="@+id/txtItemOrderCustomerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtItemOrderId"
        android:text="Όνομα πελάτη:" />

    <TextView
        android:id="@+id/txtItemOrderIdValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/txtItemOrderId"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Order #5501" />

    <TextView
        android:id="@+id/txtItemOrderStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.506"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtItemOrderPriceValue"
        android:text="ΣΕ ΑΝΑΜΟΝΗ" />

    <TextView
        android:id="@+id/txtItemOrderCustomerNameValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/txtItemOrderCustomerName"
        app:layout_constraintTop_toBottomOf="@+id/txtItemOrderIdValue"
        android:text="Γιώργος Παπαδόπουλος" />

    <TextView
        android:id="@+id/txtItemOrderSubmissionDateValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/txtItemOrderSubmissionDate"
        app:layout_constraintTop_toBottomOf="@+id/txtItemOrderCustomerNameValue"
        android:text="27 Δεκ 2023" />

    <TextView
        android:id="@+id/txtItemOrderPriceValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/txtItemOrderPrice"
        app:layout_constraintTop_toBottomOf="@+id/txtItemOrderSubmissionDateValue"
        android:text="€ 1,250.00" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnItemOrder"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        app:backgroundTint="?attr/colorPrimary"
        android:textColor="?attr/colorOnPrimary"
        app:icon="@drawable/ic_assignment"
        app:iconTint="?attr/colorOnPrimary"
        app:iconGravity="textStart"
        app:cornerRadius="8dp"
        android:text="Ανάληψη παραγγελίας"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtItemOrderStatus" />

    <View
        android:id="@+id/divider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="?attr/colorSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnItemOrder" />

</androidx.constraintlayout.widget.ConstraintLayout>