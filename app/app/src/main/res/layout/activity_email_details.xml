<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/EmailDetails"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp"
    tools:context=".view.contact.emailDetails.EmailDetailsActivity">

    <TextView
        android:id="@+id/txtEmailDetailsFrom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Από: "
        android:textColor="#424242"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtEmailDetailsSenderName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Όνομα αποστολέα"
        android:textColor="#000000"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/txtEmailDetailsSenderEmail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/txtEmailDetailsFrom"
        app:layout_constraintTop_toTopOf="@+id/txtEmailDetailsFrom" />

    <TextView
        android:id="@+id/txtEmailDetailsSenderEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="email_apostolea@example.com"
        android:textColor="#757575"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/txtEmailDetailsSenderName"
        app:layout_constraintTop_toBottomOf="@+id/txtEmailDetailsSenderName" />

    <View
        android:id="@+id/viewDivider1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@+id/txtEmailDetailsSenderEmail" />

    <TextView
        android:id="@+id/txtEmailDetailsReceiver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Προς: "
        android:textColor="#424242"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewDivider1" />

    <TextView
        android:id="@+id/txtEmailDetailsReceiverName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Όνομα παραλήπτη"
        android:textColor="#000000"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/txtEmailDetailsReceiverEmail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/txtEmailDetailsReceiver"
        app:layout_constraintTop_toTopOf="@+id/txtEmailDetailsReceiver" />

    <TextView
        android:id="@+id/txtEmailDetailsReceiverEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="email_paralipti@example.com"
        android:textColor="#757575"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/txtEmailDetailsReceiverName"
        app:layout_constraintTop_toBottomOf="@+id/txtEmailDetailsReceiverName" />

    <View
        android:id="@+id/viewDivider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@+id/txtEmailDetailsReceiverEmail" />

    <TextView
        android:id="@+id/txtEmailDetailsEmailSubject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Θέμα: "
        android:textColor="#424242"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewDivider2" />

    <TextView
        android:id="@+id/txtEmailDetailsEmailSubjectValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Το θέμα του μηνύματος"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@+id/txtEmailDetailsEmailSubject"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/txtEmailDetailsEmailSubject" />

    <View
        android:id="@+id/viewDivider3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@+id/txtEmailDetailsEmailSubjectValue" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewDivider3">

        <TextView
            android:id="@+id/txtEmailDetailsEmailBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Εδώ εμφανίζεται το κυρίως κείμενο του email. Είναι μέσα σε ScrollView για να μπορεί να κυλήσει αν το κείμενο είναι μεγάλο."
            android:textColor="#000000"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"/>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>