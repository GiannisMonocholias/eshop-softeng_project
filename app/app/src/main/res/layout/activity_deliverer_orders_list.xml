<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/delivererOrdersList"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.employee.deliverer.DelivererOrdersListActivity">

    <TextView
        android:id="@+id/txtDelivererOrders"
        android:layout_width="239dp"
        android:layout_height="19dp"
        android:layout_marginStart="86dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="86dp"
        android:text="ΠΑΡΑΓΓΕΛΙΕΣ ΠΡΟΣ ΠΑΡΑΔΟΣΗ"
        android:textSize="16dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDelivererOrders"
        android:layout_width="409dp"
        android:layout_height="694dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtDelivererOrders" />
</androidx.constraintlayout.widget.ConstraintLayout>