<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgDetail"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_gallery"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtProductDetailActivityName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Όνομα Προϊόντος"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imgDetail" />

        <TextView
            android:id="@+id/txtProductDetailActivityCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="CODE: TECH-XXX"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtProductDetailActivityName" />

        <RatingBar
            android:id="@+id/ratingBarProductDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:isIndicator="true"
            android:numStars="5"
            android:progressTint="?attr/colorPrimary"
            android:stepSize="0.1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtProductDetailActivityCode" />

        <TextView
            android:id="@+id/txtProductDetailActivityPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="0.00 €"
            android:textColor="?attr/colorPrimary"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ratingBarProductDetail" />

        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="?attr/colorSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtProductDetailActivityPrice" />

        <TextView
            android:id="@+id/txtProductDetailActivityLabelDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Περιγραφή:"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider" />

        <TextView
            android:id="@+id/txtProductDetailActivityDetailDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:text="Εδώ θα εμφανιστούν οι αναλυτικές πληροφορίες..."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtProductDetailActivityLabelDescription" />

        <TextView
            android:id="@+id/txtProductDetailActivityLabelQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Ποσότητα:"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtProductDetailActivityDetailDescription" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProductDetailActivityQuantityMinus"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            app:backgroundTint="?attr/colorSurfaceVariant"
            android:padding="0dp"
            android:text="-"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/txtProductDetailActivityLabelQuantity"
            app:layout_constraintStart_toEndOf="@+id/txtProductDetailActivityLabelQuantity"
            app:layout_constraintTop_toTopOf="@+id/txtProductDetailActivityLabelQuantity" />

        <TextView
            android:id="@+id/txtProductDetailActivityQuantity"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/btnProductDetailActivityQuantityMinus"
            app:layout_constraintStart_toEndOf="@+id/btnProductDetailActivityQuantityMinus"
            app:layout_constraintTop_toTopOf="@+id/btnProductDetailActivityQuantityMinus" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProductDetailActivityQuantityPlus"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:backgroundTint="?attr/colorSurfaceVariant"
            android:padding="0dp"
            android:text="+"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/txtProductDetailActivityQuantity"
            app:layout_constraintStart_toEndOf="@+id/txtProductDetailActivityQuantity"
            app:layout_constraintTop_toTopOf="@+id/txtProductDetailActivityQuantity" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProductDetailViewReviews"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="10dp"
            app:backgroundTint="?attr/colorPrimary"
            app:icon="@android:drawable/btn_star_big_off"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnPrimary"
            app:iconGravity="textStart"
            android:text="Προβολή Αξιολογήσεων"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtProductDetailActivityLabelQuantity" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProductDetailActivityAddCart"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="24dp"
            app:backgroundTint="?attr/colorPrimary"
            app:icon="@drawable/outline_add_shopping_cart_24"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnPrimary"
            app:iconGravity="textStart"
            android:text="Προσθήκη στο Καλάθι"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnProductDetailViewReviews" />

        <!--
        Το fragment_container_reviews το αφήνουμε όπως είναι για να μην σπάσει
        η λογική του κώδικά σου (fragment transactions). Του έβαλα δυναμικό φόντο.
        -->
        <FrameLayout
            android:id="@+id/fragment_container_reviews"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?android:attr/windowBackground"
            android:clickable="true"
            android:elevation="20dp"
            android:focusable="true"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>