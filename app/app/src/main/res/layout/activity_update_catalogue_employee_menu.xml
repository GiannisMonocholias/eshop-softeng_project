<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/UpdateCatalogueEmployeeMenu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    tools:context=".view.employee.updateCatalogueEmployee.updateCatalogueEmployeeMenu.UpdateCatalogueEmployeeMenuActivity">

    <!-- Μπάρα Εφαρμογής -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/colorPrimary"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgUserProfile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:background="?attr/colorSurface"
            android:padding="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:tint="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtUptCatEmpMenuName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:text="ΟΝΟΜΑ ΥΠΑΛΛΗΛΟΥ"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imgUserProfile"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txtUptCatEmpMenuWelcomeMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="ΚΑΛΩΣΗΡΘΑΤΕ!"
        android:textColor="?attr/colorPrimary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerContainer" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUptCatEmpMenuAssignedRequests"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="36dp"
        app:backgroundTint="?attr/colorPrimary"
        android:text="Τα Αιτήματά Μου"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_assignment"
        app:iconTint="?attr/colorOnPrimary"
        app:iconGravity="textStart"
        app:cornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtUptCatEmpMenuWelcomeMessage" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUptCatEmpMenuAssignNewRequest"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="25dp"
        app:backgroundTint="?attr/colorPrimary"
        android:text="Ανάληψη Νέων Αιτημάτων"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_add"
        app:iconTint="?attr/colorOnPrimary"
        app:iconGravity="textStart"
        app:cornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnUptCatEmpMenuAssignedRequests" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUptCatEmpMenuProcessAccount"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="25dp"
        app:backgroundTint="?attr/colorPrimary"
        android:text="Επεξεργασία Λογαριασμού"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_edit"
        app:iconTint="?attr/colorOnPrimary"
        app:iconGravity="textStart"
        app:cornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnUptCatEmpMenuAssignNewRequest" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUptCatEmpMenuDeleteAccount"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="25dp"
        app:backgroundTint="?attr/colorError"
        android:text="Διαγραφή Λογαριασμού"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_delete"
        app:iconTint="?attr/colorOnPrimary"
        app:iconGravity="textStart"
        app:cornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnUptCatEmpMenuProcessAccount" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUptCatEmpMenuLogout"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginBottom="32dp"
        app:backgroundTint="?attr/colorError"
        android:text="Αποσύνδεση"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_logout"
        app:iconTint="?attr/colorOnPrimary"
        app:iconGravity="textStart"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>