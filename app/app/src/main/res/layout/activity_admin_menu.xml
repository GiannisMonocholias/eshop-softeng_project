<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".view.admin.adminMenu.AdminMenuActivity">

    <!-- Header -->
    <TextView
        android:id="@+id/txtAdminHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp"
        android:text="Πίνακας Διαχειριστή"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:textColor="#009688"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/txtActChoice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Επιλέξτε ενέργεια"
        android:textSize="18sp"
        android:textColor="#333333"
        app:layout_constraintTop_toBottomOf="@id/txtAdminHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Edit Data -->
    <Button
        android:id="@+id/btnEditData"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="48dp"
        android:layout_marginHorizontal="32dp"
        android:text="Τροποποίηση Στοιχείων"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#009688"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtActChoice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Stats -->
    <Button
        android:id="@+id/btnQuantities"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#009688"
        android:text="Ανανέωση αποθέματος"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnEditData" />

    <!-- Requests -->
    <Button
        android:id="@+id/btnRequests"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="32dp"
        android:text="Διαχείριση Αιτημάτων"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#009688"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnQuantities"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Create Employee -->
    <Button
        android:id="@+id/btnCreateEmp"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="32dp"
        android:text="Δημιουργία Υπαλλήλου"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#009688"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnRequests"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Delete Employee -->
    <Button
        android:id="@+id/btnDeleteEmp"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#BF211D"
        android:text="Διαγραφή Υπαλλήλου"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCreateEmp" />

</androidx.constraintlayout.widget.ConstraintLayout>
