<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activityCseDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#766F6F"
    tools:context=".view.employee.customerServiceEmployee.CustomerServiceMenuActivity">


    <TextView
        android:id="@+id/txtWelcomeMessage2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="ΚΑΛΩΣΗΡΘΑΤΕ!"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtOrdPrepEmpMenuName" />

    <TextView
        android:id="@+id/txtOrdPrepEmpMenuName"
        android:layout_width="fill_parent"
        android:layout_height="42dp"
        android:background="#009688"
        android:elevation="12dp"
        android:text="ΟΝΟΜΑ ΥΠΑΛΛΗΛΟΥ"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnOrdPrepEmpMenuAssignedOrders"
        android:layout_width="382dp"
        android:layout_height="115dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#673AB7"
        android:text="Διαχείριση Εισερχομένων μηνυμάτων και σύνταξη"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.413"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtWelcomeMessage2" />

    <Button
        android:id="@+id/btnOrdPrepEmpMenuAssignNewOrder"
        android:layout_width="377dp"
        android:layout_height="104dp"
        android:layout_marginTop="25dp"
        android:backgroundTint="#673AB7"
        android:text="Ενημέρωση πορείας παραγγελιών"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnOrdPrepEmpMenuAssignedOrders" />

    <Button
        android:id="@+id/btnOrdPrepEmpMenuLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:backgroundTint="#BF211D"
        android:drawableLeft="@drawable/account_logout"
        android:elevation="8dp"
        android:text="Αποσύνδεση"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>