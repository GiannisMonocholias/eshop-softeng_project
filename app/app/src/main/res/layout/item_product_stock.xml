<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/txtItemProductStockProductCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Κωδικός:"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtItemProductStockProductCodeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="#PRD-3402"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            app:layout_constraintBaseline_toBaselineOf="@+id/txtItemProductStockProductCode"
            app:layout_constraintStart_toEndOf="@+id/txtItemProductStockProductCode" />

        <TextView
            android:id="@+id/txtItemProductStockProductName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Προϊόν:"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtItemProductStockProductCode" />

        <TextView
            android:id="@+id/txtItemProductStockProductNameValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Laptop Dell XPS"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            app:layout_constraintBaseline_toBaselineOf="@+id/txtItemProductStockProductName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txtItemProductStockProductName" />

        <TextView
            android:id="@+id/txtItemProductStockSubTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Τιμή:"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtItemProductStockProductName" />

        <TextView
            android:id="@+id/txtItemProductStockSubTotalValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="1200.00 €"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@+id/txtItemProductStockSubTotal"
            app:layout_constraintStart_toEndOf="@+id/txtItemProductStockSubTotal" />

        <TextView
            android:id="@+id/txtItemProductStockRequestedQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ζητούμενη:"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtItemProductStockSubTotal" />

        <TextView
            android:id="@+id/txtItemProductStockRequestedQuantityValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@+id/txtItemProductStockRequestedQuantity"
            app:layout_constraintStart_toEndOf="@+id/txtItemProductStockRequestedQuantity" />

        <TextView
            android:id="@+id/txtItemProductStockStockQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Απόθεμα:"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            app:layout_constraintBaseline_toBaselineOf="@+id/txtItemProductStockRequestedQuantity"
            app:layout_constraintStart_toEndOf="@+id/txtItemProductStockRequestedQuantityValue" />

        <TextView
            android:id="@+id/txtItemProductStockStockQuantityValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="15"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@+id/txtItemProductStockStockQuantity"
            app:layout_constraintStart_toEndOf="@+id/txtItemProductStockStockQuantity" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>