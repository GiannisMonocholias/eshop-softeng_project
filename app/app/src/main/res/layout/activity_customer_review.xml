<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:padding="16dp"
    tools:context=".view.customer.Review.CustomerReviewActivity">

    <!-- Τίτλος -->
    <TextView
        android:id="@+id/tvReviewsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-black"
        android:text="Αξιολόγηση Προϊόντος"
        android:textAlignment="center"
        android:textColor="?attr/colorPrimary"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Υπότιτλος -->
    <TextView
        android:id="@+id/textViewSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Πείτε μας τη γνώμη σας"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvReviewsTitle" />

    <!-- Οδηγία για Αστεράκια -->
    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Επιλέξτε πλήθος αστεριών"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewSub" />

    <!-- Αστεράκια (Rating Bar) -->
    <RatingBar
        android:id="@+id/ratingBarReviews"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:numStars="5"
        android:progressTint="?attr/colorPrimary"
        android:rating="0"
        android:secondaryProgressTint="?attr/colorPrimary"
        android:stepSize="1.0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <!-- Πεδίο Σχολίου -->
    <EditText
        android:id="@+id/etReviewsComment"
        android:layout_width="0dp"
        android:layout_height="111dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="32dp"
        android:background="@android:drawable/editbox_background"
        android:backgroundTint="?attr/colorSurfaceVariant"
        android:gravity="top|start"
        android:hint="Γράψτε το σχόλιό σας εδώ..."
        android:textColorHint="?attr/colorOnSurfaceVariant"
        android:textColor="?attr/colorOnSurface"
        android:inputType="textMultiLine"
        android:lines="5"
        android:minLines="4"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ratingBarReviews" />

    <!-- Κουμπί Υποβολής -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReviewsSubmit"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="48dp"
        app:backgroundTint="?attr/colorPrimary"
        android:text="Υποβολή"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:icon="@drawable/send_email_icon"
        app:iconSize="24dp"
        app:iconTint="?attr/colorOnPrimary"
        app:iconGravity="textStart"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etReviewsComment" />

</androidx.constraintlayout.widget.ConstraintLayout>