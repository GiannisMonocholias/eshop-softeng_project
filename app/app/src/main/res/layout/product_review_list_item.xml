<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="8dp"
    android:background="#FFFFFF"
    android:elevation="2dp"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imgReviewUserIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/shape_circle_avatar"
        android:padding="8dp"
        android:src="@drawable/ic_person"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#009688" />

    <TextView
        android:id="@+id/txtReviewUsername"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:text="Όνομα Χρήστη"
        android:textColor="#009688"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/txtReviewDate"
        app:layout_constraintStart_toEndOf="@+id/imgReviewUserIcon"
        app:layout_constraintTop_toTopOf="@+id/imgReviewUserIcon" />

    <RatingBar
        android:id="@+id/ratingBarReview"
        style="?android:attr/ratingBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:isIndicator="true"
        android:numStars="5"
        android:progressTint="#FFC107"
        android:stepSize="0.5"
        app:layout_constraintStart_toStartOf="@+id/txtReviewUsername"
        app:layout_constraintTop_toBottomOf="@+id/txtReviewUsername" />

    <TextView
        android:id="@+id/txtReviewDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="18/09/2026"
        android:textColor="#888888"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/txtReviewUsername"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txtReviewUsername" />

    <TextView
        android:id="@+id/txtReviewComment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Αυτή είναι μια δοκιμαστική αξιολόγηση. Το προϊόν ήταν εξαιρετικό και η παράδοση έγινε άμεσα. Το προτείνω ανεπιφύλακτα!"
        android:textColor="#333333"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgReviewUserIcon" />

</androidx.constraintlayout.widget.ConstraintLayout>